# OpenAI 兼容代理(国内中转 Gemini 走这个协议)
# key 与 base_url 由你的代理服务商提供
# 注意 base_url 必须保留 /v1 后缀 —— OpenAI SDK 会把 /chat/completions 拼在末尾
GEMINI_API_KEY=sk-bxGWxD9NqF6q9aFPE4764bEc494148088c457384A31aDeFa
GEMINI_BASE_URL=https://api.openai-next.com/v1
GEMINI_MODEL=gemini-3.1-pro-preview
# 图生视频模型 —— Seedance 2.0(字节)、veo3.1-pro 等都可,以代理「可用模型」为准
VIDEO_MODEL=doubao-seedance-2-0-fast-260128
# Seedance 走火山 ark 的 task API(不是 OpenAI 兼容协议),代理路径不同
SEEDANCE_BASE_URL=https://api.openai-next.com/seedance/api/v3

# Optional: low-confidence threshold (0-1). Below this we fall back to ISFP.
GEMINI_MIN_CONFIDENCE=0.4

# 视频抽帧数量(OpenAI chat completions 不支持视频,必须先抽帧)
# 太少 → 信息不足;太多 → 请求体积大 + 代理可能 413
VIDEO_FRAME_COUNT=8
VIDEO_FRAME_JPEG_QUALITY=70

# 网络行为 —— 国内代理走 VPN 容易 TLS 握手超时,改 False 直连
GEMINI_USE_SYSTEM_PROXY=False
GEMINI_CONNECT_TIMEOUT=30
GEMINI_READ_TIMEOUT=180
GEMINI_WRITE_TIMEOUT=60
VIDEO_FRAME_JPEG_QUALITY=70
